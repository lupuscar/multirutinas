# =====================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - MULTIRUTINAS (FITAPP)
# =====================================================================
# Copia este archivo como '.env' en la raíz de tu proyecto en el VPS
# y completa los valores con tus credenciales y dominio reales.

# 1. Clave secreta de Django (Genera una clave aleatoria y segura)
# Puedes generar una con: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=cambia_esta_clave_por_una_cadena_secreta_y_aleatoria_de_al_menos_50_caracteres

# 2. Modo Depuración (Siempre False en producción)
DEBUG=False

# 3. Dominio de la Aplicación en Traefik
# El subdominio que apuntará a tu app (debe tener un registro DNS tipo A hacia la IP de tu VPS)
APP_DOMAIN=fit.z2informatica.com

# 4. Hosts permitidos (separados por coma)
ALLOWED_HOSTS=fit.z2informatica.com,localhost,127.0.0.1,web

# 5. Orígenes confiables para CSRF (Obligatorio en Django 4+ con HTTPS y Traefik)
CSRF_TRUSTED_ORIGINS=https://fit.z2informatica.com

# 6. Base de Datos PostgreSQL (Contenedor interno 'db')
POSTGRES_DB=multirutinas_db
POSTGRES_USER=multirutinas_user
POSTGRES_PASSWORD=genera_una_contrasena_fuerte_para_la_base_de_datos

# 7. Configuración de Email (SMTP para envío de correos y recuperación de contraseñas)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu_usuario_smtp
EMAIL_HOST_PASSWORD=tu_clave_smtp
DEFAULT_FROM_EMAIL=FitApp <no-reply@z2informatica.com>

# 8. Seguridad: Caducidad del enlace de recuperación de contraseña (en segundos, 3600 = 1 hora)
PASSWORD_RESET_TIMEOUT=3600
